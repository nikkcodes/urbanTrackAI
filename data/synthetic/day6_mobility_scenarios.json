    "case7_closed_road": {
      "name": "Case 7: Closed Road",
      "description": "Route referencing a closed road is excluded from valid flow allocation",
      "trajectory": {
        "track_id": "VEH_CASE_07",
        "origin_node": "J01",
        "destination_node": "J03",
        "vehicle_weight": 1.0,
        "candidate_routes": [
          {
            "nodes": ["J01", "J02", "J03"],
            "probability": 1.0,
            "metadata": {"edges": ["R01", "R02"]}
          }
        ]
      },
      "closed_road_id": "R02"
    },
    "case8_ambiguous_trajectory": {
      "name": "Case 8: Ambiguous Trajectory",
      "description": "Equal likelihood alternative corridors (0.50 / 0.50)",
      "trajectory": {
        "track_id": "VEH_CASE_08_AMB",
        "origin_node": "J01",
        "destination_node": "J05",
        "vehicle_weight": 1.0,
        "candidate_routes": [
          {
            "nodes": ["J01", "J02", "J05"],
            "probability": 0.50,
            "metadata": {"edges": ["R01", "R08"]}
          },
          {
            "nodes": ["J01", "J04", "J05"],
            "probability": 0.50,
            "metadata": {"edges": ["R07", "R18"]}
          }
        ],
        "metadata": {
          "trajectory_reliability": 0.85,
          "trajectory_uncertainty": 0.35,
          "is_ambiguous": true
        }
      },
      "expected": {
        "road_demands": {
          "R01": 0.50,
          "R08": 0.50,
          "R07": 0.50,
          "R18": 0.50
        }
      }
    },
    "case9_low_reliability": {
      "name": "Case 9: Low Reliability Independence",
      "description": "Same physical vehicle and routes as Case 8, but degraded Day 5 reliability",
      "trajectory": {
        "track_id": "VEH_CASE_09_LOW_REL",
        "origin_node": "J01",
        "destination_node": "J05",
        "vehicle_weight": 1.0,
        "candidate_routes": [
          {
            "nodes": ["J01", "J02", "J05"],
