      ],
      "expected": {
        "road_demands": {
          "R01": 3.0,
          "R02": 1.0,
          "R08": 3.5
        }
      }
    },
    "case6_different_od_pairs": {
      "name": "Case 6: Different OD Pairs",
      "description": "Trajectories spanning different origin-destination pairs",
      "trajectories": [
        {
          "track_id": "VEH_06_A",
          "origin_node": "J01",
          "destination_node": "J03",
          "vehicle_weight": 1.0,
          "candidate_routes": [
            {
              "nodes": ["J01", "J02", "J03"],
              "probability": 1.0,
              "metadata": {"edges": ["R01", "R02"]}
            }
          ]
        },
        {
          "track_id": "VEH_06_B",
          "origin_node": "J01",
          "destination_node": "J03",
          "vehicle_weight": 2.0,
          "candidate_routes": [
            {
              "nodes": ["J01", "J02", "J03"],
              "probability": 1.0,
