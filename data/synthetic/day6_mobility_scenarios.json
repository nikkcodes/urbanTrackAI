            }
          ]
        },
        {
          "track_id": "VEH_05_C",
          "origin_node": "J02",
          "destination_node": "J05",
          "vehicle_weight": 1.5,
          "candidate_routes": [
            {
              "nodes": ["J02", "J05"],
