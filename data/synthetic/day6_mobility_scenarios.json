{
  "description": "Controlled Day 6 Mobility Analytics test cases for UrbanTrack AI",
  "scenarios": {
    "case1_single_clear_route": {
      "name": "Case 1: Single Clear Route",
      "description": "One vehicle with one route with probability 1.0",
      "trajectory": {
        "track_id": "VEH_CASE_01",
        "origin_node": "J01",
        "destination_node": "J03",
        "vehicle_weight": 1.0,
        "time_window_start": 1000.0,
        "time_window_end": 1100.0,
        "candidate_routes": [
          {
            "nodes": ["J01", "J02", "J03"],
            "probability": 1.0,
            "metadata": {"edges": ["R01", "R02"]}
          }
        ],
        "metadata": {
          "trajectory_reliability": 0.95,
          "trajectory_uncertainty": 0.05
        }
      },
      "expected": {
        "road_demands": {"R01": 1.0, "R02": 1.0},
        "od_pairs": {"J01->J03": 1.0}
      }
    },
    "case2_two_routes": {
      "name": "Case 2: Two Routes",
      "description": "One vehicle with two candidate routes (0.7 and 0.3)",
      "trajectory": {
        "track_id": "VEH_CASE_02",
        "origin_node": "J01",
        "destination_node": "J05",
        "vehicle_weight": 1.0,
        "time_window_start": 1000.0,
        "time_window_end": 1150.0,
        "candidate_routes": [
          {
            "nodes": ["J01", "J02", "J05"],
            "probability": 0.70,
            "metadata": {"edges": ["R01", "R08"]}
          },
          {
            "nodes": ["J01", "J04", "J05"],
            "probability": 0.30,
            "metadata": {"edges": ["R07", "R18"]}
          }
        ],
        "metadata": {
          "trajectory_reliability": 0.88,
          "trajectory_uncertainty": 0.12
        }
      },
      "expected": {
        "road_demands": {"R01": 0.70, "R08": 0.70, "R07": 0.30, "R18": 0.30},
        "od_pairs": {"J01->J05": 1.0}
      }
    },
    "case3_shared_road": {
      "name": "Case 3: Shared Road",
      "description": "Two candidate routes share initial road segment R01",
      "trajectory": {
        "track_id": "VEH_CASE_03",
        "origin_node": "J01",
        "destination_node": "J08",
        "vehicle_weight": 1.0,
        "time_window_start": 1000.0,
        "time_window_end": 1200.0,
        "candidate_routes": [
          {
            "nodes": ["J01", "J02", "J05", "J08"],
            "probability": 0.60,
            "metadata": {"edges": ["R01", "R08", "R09"]}
          },
          {
            "nodes": ["J01", "J02", "J03", "J06", "J08"],
            "probability": 0.40,
            "metadata": {"edges": ["R01", "R02", "R03", "R21"]}
          }
        ],
        "metadata": {
          "trajectory_reliability": 0.90,
          "trajectory_uncertainty": 0.10
        }
      },
      "expected": {
        "road_demands": {
          "R01": 1.00,
          "R08": 0.60,
          "R09": 0.60,
          "R02": 0.40,
          "R03": 0.40,
          "R21": 0.40
        },
        "od_pairs": {"J01->J08": 1.0}
      }
    },
    "case4_heavy_vehicle": {
      "name": "Case 4: Heavy Vehicle",
      "description": "Vehicle with physical weight 2.5 (PCU factor)",
      "trajectory": {
        "track_id": "VEH_CASE_04_TRUCK",
        "origin_node": "J01",
        "destination_node": "J03",
        "vehicle_weight": 2.5,
        "time_window_start": 1050.0,
        "time_window_end": 1150.0,
        "candidate_routes": [
          {
            "nodes": ["J01", "J02", "J03"],
            "probability": 1.0,
            "metadata": {"edges": ["R01", "R02"]}
          }
        ],
        "metadata": {
          "vehicle_type": "truck",
          "trajectory_reliability": 0.92,
          "trajectory_uncertainty": 0.08
        }
      },
      "expected": {
        "road_demands": {"R01": 2.5, "R02": 2.5},
        "od_pairs": {"J01->J03": 2.5}
      }
    },
    "case5_multiple_vehicles": {
      "name": "Case 5: Multiple Vehicles",
