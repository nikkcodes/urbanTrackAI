        },
        {
          "track_id": "VEH_05_B",
          "origin_node": "J01",
          "destination_node": "J05",
          "vehicle_weight": 2.0,
          "candidate_routes": [
            {
              "nodes": ["J01", "J02", "J05"],
              "probability": 1.0,
