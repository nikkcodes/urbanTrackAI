{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VehicleTrajectory",
  "description": "Reconstructed multi-camera vehicle trajectory hypothesis output by Member 2.",
  "type": "object",
  "required": [
    "identity_id",
    "observations_count",
    "cameras_visited",
    "start_timestamp",
    "end_timestamp",
    "total_time_seconds",
    "total_distance_m",
    "overall_confidence",
    "is_ambiguous",
    "segments",
    "spatial_semantics",
    "temporal_semantics"
  ],
  "properties": {
    "identity_id": {
      "type": "string",
      "description": "Inferred vehicle identity ID (e.g. UT_ID_0001)."
    },
    "observations_count": {
      "type": "integer",
      "minimum": 0
    },
    "cameras_visited": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "start_timestamp": {
      "type": "number",
      "description": "Earliest observation timestamp (seconds)."
    },
    "end_timestamp": {
      "type": "number",
      "description": "Latest observation timestamp (seconds)."
    },
    "total_time_seconds": {
      "type": "number",
      "minimum": 0.0,
      "description": "Total elapsed journey time (seconds)."
    },
    "total_distance_m": {
      "type": "number",
      "minimum": 0.0,
      "description": "Traversed distance in meters (0.0 when road-network unassociated)."
    },
    "overall_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence score for the full trajectory hypothesis."
    },
    "is_ambiguous": {
      "type": "boolean",
      "description": "Flag indicating if multiple competing routes or unassociated cameras exist."
    },
    "most_likely_route": {
      "type": "array",
      "description": "List of road segments for the highest-likelihood corridor."
    },
    "complete_route_nodes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Complete sequence of visited nodes / cameras."
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "segment_id",
          "identity_id",
          "start_observation",
          "end_observation",
          "time_difference_seconds",
          "status"
        ],
        "properties": {
          "segment_id": {
            "type": "string"
          },
          "identity_id": {
            "type": "string"
          },
          "start_observation": {
            "type": "object"
          },
          "end_observation": {
            "type": "object"
          },
          "time_difference_seconds": {
            "type": [
              "number",
              "null"
            ]
          },
          "candidate_routes": {
            "type": "array"
          },
          "most_likely_route": {
            "type": [
              "object",
              "null"
            ]
          },
          "confidence": {
            "type": "number"
          },
          "is_ambiguous": {
            "type": "boolean"
          },
          "ambiguity_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "temporal_evidence": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    },
    "gaps_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of unobserved spatial/temporal intervals between camera sightings."
    },
    "reliability": {
      "type": "object",
      "properties": {
        "overall_reliability": {
          "type": "number"
        },
        "overall_uncertainty": {
          "type": "number"
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "properties": {
        "overall_uncertainty": {
          "type": "number"
        },
        "score": {
          "type": "number"
        },
        "level": {
          "type": "string"
        }
      }
    },
    "spatial_semantics": {
      "type": "string",
      "enum": [
        "cityflow_world",
        "image_space_only"
      ],
      "description": "Coordinate system semantics for trajectory waypoints. Local planar metric meters, NOT GPS."
    },
    "temporal_semantics": {
      "type": "string",
      "enum": [
        "video_relative",
        "aicity_official_synchronized"
      ],
      "description": "Timestamp semantics."
    }
  }
}